#version 450

layout(std140, binding = 0) uniform MaterialBlock {
    vec4 BaseColor;
};

layout(std140, binding = 1) uniform LightBlock {
    vec4 AmbientLightColor;
    vec4 DirectionalLightColor;
    vec4 DirectionalLightDirection;
};

layout(std140, binding = 3) uniform ShadowSettingsBlock {
    float ShadowBias;
};

layout(location = 0) in vec3 VertexNormal;
layout(location = 1) in vec2 VertexTexCoord;
layout(location = 2) in vec4 ShadowPosition;

layout(binding = 0) uniform sampler2D BaseColorTexture;
layout(binding = 1) uniform sampler2D ShadowTexture;

layout(location = 0) out vec4 FragColor;

void main() {
    vec3 shadowCoordinate = ShadowPosition.xyz / ShadowPosition.w;
    vec2 shadowUv = (shadowCoordinate.xy * 0.5) + 0.5;
    float shadowDepth = texture(ShadowTexture, shadowUv).r;
    float visibility = shadowCoordinate.z <= shadowDepth + ShadowBias ? 1.0 : 0.0;
    vec3 surfaceNormal = normalize(VertexNormal);
    vec3 lightDirection = normalize(-DirectionalLightDirection.xyz);
    float diffuseStrength = max(dot(surfaceNormal, lightDirection), 0.0);
    vec3 litColor = AmbientLightColor.xyz + (DirectionalLightColor.xyz * diffuseStrength * visibility);
    vec4 sampledBaseColor = texture(BaseColorTexture, VertexTexCoord);
    FragColor = vec4(clamp(BaseColor.rgb * sampledBaseColor.rgb * litColor, 0.0, 1.0), BaseColor.w * sampledBaseColor.a);
}
