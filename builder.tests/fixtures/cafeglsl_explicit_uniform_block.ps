#version 330
#ifdef GL_ARB_shading_language_420pack
#extension GL_ARB_shading_language_420pack : require
#endif

layout(binding = 7, std140) uniform ExplicitBindingBuffer
{
    vec4 ProbeColor;
} ExplicitBindingBuffer_1;

layout(location = 0) out vec4 OutputColor;

void main()
{
    OutputColor = ExplicitBindingBuffer_1.ProbeColor;
}
