#version 450
#extension GL_ARB_shading_language_420pack: enable

layout(std140, binding = 1) uniform MaterialBlock {
    vec4 BaseColor;
    vec4 EmissiveColor;
};

layout(std140, binding = 2) uniform LightBlock {
    vec4 AmbientLightColor;
    vec4 DirectionalLightColor;
    vec4 DirectionalLightDirection;
};

layout(location = 0) in vec3 VertexNormal;

layout(location = 0) out vec4 FragColor;

void main() {
    vec3 normal = normalize(VertexNormal);
    vec3 lightDirection = normalize(-DirectionalLightDirection.xyz);
    float lambert = max(dot(normal, lightDirection), 0.0);
    vec3 lighting = AmbientLightColor.xyz + (DirectionalLightColor.xyz * lambert);
    vec3 color = (BaseColor.xyz * lighting) + EmissiveColor.xyz;
    FragColor = vec4(color, BaseColor.w);
}
